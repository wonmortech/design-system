{
  "name": "@wonmor/tokens",
  "version": "0.1.0",
  "private": false,
  "description": "Design tokens (CSS custom properties and JSON) used by wonmor.io. Not yet published to npm.",
  "license": "MIT",
  "homepage": "https://wonmor.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wonmortech/design-system.git"
  },
  "style": "tokens/tokens.css",
  "exports": {
    "./tokens.css": "./tokens/tokens.css",
    "./tokens.json": "./tokens/tokens.json",
    "./package.json": "./package.json"
  },
  "files": [
    "tokens/",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "design-tokens",
    "css-custom-properties",
    "wonmor"
  ],
  "scripts": {
    "demo:build": "node tools/build-demo.mjs",
    "demo": "node tools/build-demo.mjs && node tools/serve-demo.mjs",
    "test:demo": "playwright test -c playwright.demo.config.mjs",
    "site:screenshots": "node tools/site-screenshots.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/onest": "5.3.1",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@playwright/test": "1.65.0"
  }
}
